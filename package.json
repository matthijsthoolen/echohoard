{
  "name": "echohoard",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "pnpm exec prisma generate && next build src/delivery/web",
    "build:worker": "tsc -p tsconfig.worker.json",
    "dev": "next dev",
    "start": "next start src/delivery/web",
    "start:worker": "node dist/worker/index.js",
    "architecture": "node tools/check-architecture.mjs",
    "architecture:fixture": "node tools/check-architecture.mjs --fixture",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate": "sh scripts/migrate.sh",
    "test:functional": "bash scripts/test-functional.sh",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --coverage src",
    "test:fixtures": "vitest run src/adapters/whatsapp/fixtures.test.ts src/adapters/whatsapp/contract.test.ts",
    "generate:fixtures": "tsx scripts/generate-whatsapp-fixtures.ts",
    "generate:corpus": "tsx scripts/generate-reference-corpus.ts",
    "benchmark:reads": "tsx scripts/benchmark-reads.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:viewer": "node scripts/viewer-acceptance.mjs",
    "test:container": "sh scripts/test-container.sh",
    "test:container-acceptance": "bash scripts/test-container-acceptance.sh",
    "test:compose-lifecycle": "sh scripts/test-compose-lifecycle.sh",
    "profile:viewer-memory": "node scripts/profile-viewer-memory.mjs",
    "supply-chain:verify": "node scripts/verify-supply-chain.mjs",
    "supply-chain:rollback": "node scripts/rollback-dry-run.mjs",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm architecture && pnpm test:unit && pnpm test:browser && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "6.16.2",
    "jose": "6.2.12",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.3",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
