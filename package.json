{
  "name": "echohoard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": { "node": ">=22.14.0 <23" },
  "scripts": {
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build src/delivery/web",
    "build:worker": "tsc -p tsconfig.worker.json",
    "dev": "next dev",
    "start": "next start src/delivery/web",
    "start:worker": "node dist/worker/index.js",
    "architecture": "node tools/check-architecture.mjs",
    "architecture:fixture": "node tools/check-architecture.mjs --fixture",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "test:functional": "bash scripts/test-functional.sh"
  },
  "dependencies": { "@prisma/client": "6.16.2", "next": "15.5.3", "react": "19.1.1", "react-dom": "19.1.1", "zod": "4.1.5" },
  "devDependencies": { "@types/node": "22.15.30", "@types/react": "19.1.10", "@types/react-dom": "19.1.7", "prisma": "6.16.2", "tsx": "4.19.2", "typescript": "5.9.2", "vitest": "3.2.4" }
}
