{
  "name": "EchoHoard",
  "version": 1,
  "colors": {
    "ink": "#17212B",
    "inkMuted": "#5B6875",
    "canvas": "#F5F7FA",
    "surface": "#FFFFFF",
    "surfaceMuted": "#EEF2F5",
    "line": "#D7DEE7",
    "accent": "#0A7C86",
    "accentStrong": "#075E67",
    "accentSoft": "#D7F1F0",
    "violet": "#635B8F",
    "success": "#237A4E",
    "warning": "#946200",
    "danger": "#B23A48",
    "focus": "#2563EB",
    "unread": "#D95F59"
  },
  "typography": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
    "monoFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "sizes": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "display": "1.75rem" },
    "lineHeights": { "tight": 1.2, "normal": 1.5, "relaxed": 1.65 }
  },
  "spacing": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem" },
  "radii": { "sm": "0.5rem", "md": "0.75rem", "lg": "1rem", "pill": "999px" },
  "shadows": { "subtle": "0 1px 2px rgb(23 33 43 / 0.06)", "raised": "0 8px 24px rgb(23 33 43 / 0.10)", "overlay": "0 16px 48px rgb(23 33 43 / 0.18)" },
  "breakpoints": { "mobile": "0px", "tablet": "720px", "desktop": "1024px", "wide": "1440px" },
  "motion": { "fast": "120ms", "normal": "180ms", "slow": "280ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "contrastPairs": [
    ["ink", "surface"],
    ["inkMuted", "surface"],
    ["accentStrong", "surface"],
    ["surface", "accentStrong"],
    ["surface", "danger"],
    ["surface", "success"]
  ]
}
