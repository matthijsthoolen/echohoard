generator client {
  provider      = "prisma-client-js"
  // The packaged runtime uses Debian Bookworm/OpenSSL 3. Keep native for
  // local development while embedding the deployment engine explicitly.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archives  Archive[]
}

model Archive {
  id                              String                           @id @default(uuid()) @db.Uuid
  userId                          String                           @db.Uuid
  name                            String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  user                            User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources                         Source[]
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  importEligibilityDecisions      ImportEligibilityDecision[]
  materializationRuns             MaterializationRun[]
  ownedAccounts                   OwnedAccount[]
  people                          Person[]
  identities                      Identity[]
  conversations                   Conversation[]
  sourceConversations             SourceConversation[]
  conversationMergeAudits         ConversationMergeAudit[]
  participants                    ConversationParticipant[]
  messages                        Message[]
  revisions                       MessageRevision[]
  reactions                       Reaction[]
  attachments                     Attachment[]
  messageAttachments              MessageAttachment[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]
  ownerDeletionAudits             OwnerDeletionAudit[]
  transcripts                     Transcript[]
  transcriptionRequests           TranscriptionRequest[]
  transcriptionRuns               TranscriptionRun[]
  transcriptVersions              TranscriptVersion[]
  admittedIdentities              ArchiveIdentity[]
  authSessions                    AuthSession[]
  unlockChallenges                UnlockChallenge[]
  unlockGrants                    UnlockGrant[]
  privacyAudits                   ConversationPrivacyAudit[]
  liveEventInbox                  LiveEventInbox[]
  transcriptionModel              String?

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model ArchiveIdentity {
  id         String    @id @default(uuid()) @db.Uuid
  archiveId  String    @db.Uuid
  issuer     String
  subject    String
  role       String    @default("pending")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archive    Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, issuer, subject])
  @@index([archiveId, role])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  archiveId String    @db.Uuid
  issuer    String
  subject   String
  role      String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archive   Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  unlockChallenges UnlockChallenge[]
  unlockGrants     UnlockGrant[]

  @@index([expiresAt, revokedAt])
  @@index([archiveId, expiresAt])
  @@unique([id, archiveId])
}

/// A one-use, process-bound OIDC step-up challenge. The browser state is
/// never persisted in plaintext and cannot be replayed after consumption.
model UnlockChallenge {
  id             String       @id @default(uuid()) @db.Uuid
  tokenHash      String       @unique @db.VarChar(64)
  runtimeId      String       @db.VarChar(64)
  sessionHash    String       @db.VarChar(64)
  authSessionId  String       @db.Uuid
  archiveId      String       @db.Uuid
  conversationId String       @db.Uuid
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authSession    AuthSession  @relation(fields: [authSessionId, archiveId], references: [id, archiveId], onDelete: Cascade)
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@index([runtimeId, expiresAt, consumedAt, revokedAt])
  @@index([sessionHash, archiveId, conversationId])
}

/// A short-lived server-side grant. runtimeId deliberately makes all grants
/// fail closed after a web-process restart; the owner must perform step-up
/// again even though the durable OIDC session remains valid.
model UnlockGrant {
  id             String       @id @default(uuid()) @db.Uuid
  tokenHash      String       @unique @db.VarChar(64)
  runtimeId      String       @db.VarChar(64)
  sessionHash    String       @db.VarChar(64)
  authSessionId  String       @db.Uuid
  archiveId      String       @db.Uuid
  conversationId String       @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authSession    AuthSession  @relation(fields: [authSessionId, archiveId], references: [id, archiveId], onDelete: Cascade)
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@index([runtimeId, expiresAt, revokedAt])
  @@index([sessionHash, archiveId, conversationId])
}

model OwnedAccount {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  accountKey                      String
  displayLabel                    String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  sources                         Source[]
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  sourceConversations             SourceConversation[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]
  liveEventInbox                  LiveEventInbox[]

  @@unique([archiveId, id])
  @@unique([archiveId, accountKey])
  @@index([archiveId])
}

model LiveEventInbox {
  id             String       @id @default(uuid()) @db.Uuid
  archiveId      String       @db.Uuid
  ownedAccountId String       @db.Uuid
  receiptId      String       @db.VarChar(64)
  sourceEventKey String       @db.VarChar(512)
  eventKind      String       @db.VarChar(64)
  payload        Json
  observedAt     DateTime
  receivedAt     DateTime     @default(now())
  status         String       @default("pending") @db.VarChar(32)
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount   OwnedAccount @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, ownedAccountId, receiptId])
  @@index([archiveId, ownedAccountId, status, createdAt])
}

model Source {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  kind                            String
  stableKey                       String
  sha256                          String                           @db.VarChar(64)
  originalPath                    String?
  provenance                      Json?
  lifecycle                       String                           @default("discovered")
  discoveredAt                    DateTime                         @default(now())
  claimedAt                       DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@unique([archiveId, ownedAccountId, kind, stableKey])
  @@index([archiveId, sha256])
}

model Snapshot {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  sourceId                        String                           @db.Uuid
  sha256                          String                           @db.VarChar(64)
  provenance                      Json?
  lifecycle                       String                           @default("snapshotted")
  capturedAt                      DateTime                         @default(now())
  completedAt                     DateTime?
  createdAt                       DateTime                         @default(now())
  source                          Source                           @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJobs                      ImportJob[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@unique([archiveId, ownedAccountId, sourceId, sha256])
  @@index([archiveId, sourceId])
  @@index([archiveId, lifecycle, completedAt])
  @@index([archiveId, capturedAt])
}

model ImportJob {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  sourceId                        String                           @db.Uuid
  snapshotId                      String?                          @db.Uuid
  status                          String                           @default("discovered")
  eligibility                     String                           @default("eligible")
  adapterVersion                  String?
  outcome                         Json?
  errorClass                      String?
  retryable                       Boolean?
  leaseId                         String?
  leaseOwner                      String?
  leaseExpiresAt                  DateTime?
  startedAt                       DateTime?
  finishedAt                      DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                          Source                           @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot                        Snapshot?                        @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]
  importEligibilityDecisions      ImportEligibilityDecision[]
  materializationRuns             MaterializationRun[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@index([archiveId, status])
  @@index([status, leaseExpiresAt])
  @@index([archiveId, createdAt])
  @@index([archiveId, eligibility])
}

model Person {
  id           String                    @id @default(uuid()) @db.Uuid
  archiveId    String                    @db.Uuid
  displayName  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  archive      Archive                   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  identities   Identity[]
  participants ConversationParticipant[]
  sentMessages Message[]
  reactions    Reaction[]

  @@unique([archiveId, id])
  @@index([archiveId])
}

model Identity {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  personId    String   @db.Uuid
  kind        String
  value       String
  displayName String?
  provenance  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archive     Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, kind, value])
  @@index([archiveId, personId])
}

model Conversation {
  id                           String                     @id @default(uuid()) @db.Uuid
  archiveId                    String                     @db.Uuid
  kind                         String
  stableKey                    String
  title                        String?
  ownerTitle                   String?
  ownerAvatar                  String?
  groupingVersion              Int                       @default(0)
  groupingLocked               Boolean                   @default(false)
  materialized                 Boolean                   @default(true)
  materializationRunId         String?
  materializationInputDigest   String?                    @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean                    @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  uiVisibility                 String                     @default("normal")
  mcpAccess                    String                     @default("allowed")
  sourceLockMetadata           Json?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  archive                      Archive                    @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownerDeletionVersion         Int                       @default(0)
  participants                 ConversationParticipant[]
  messages                     Message[]
  sourceConversations          SourceConversation[]
  mergeAudits                  ConversationMergeAudit[]
  privacyAudits                ConversationPrivacyAudit[]
  unlockChallenges             UnlockChallenge[]
  unlockGrants                 UnlockGrant[]

  @@unique([archiveId, id])
  @@unique([archiveId, stableKey])
  @@index([archiveId, kind])
}

/// Append-only owner commands changing presentation grouping. Source rows and
/// observations are never rewritten; this is the reversible evidence of the
/// projection change.
model ConversationMergeAudit {
  id                           String   @id @default(uuid()) @db.Uuid
  archiveId                    String   @db.Uuid
  targetConversationId         String   @db.Uuid
  action                       String
  sourceConversationIds        Json
  previousGroups               Json
  resultingVersion             Int
  expectedVersion              Int
  actor                        String
  reason                       String
  idempotencyKey               String
  metadata                     Json?
  createdAt                    DateTime @default(now())
  archive                      Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  targetConversation           Conversation @relation(fields: [targetConversationId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, idempotencyKey])
  @@index([archiveId, targetConversationId, createdAt])
}

/// Identifiers and actions only. Titles, identities, content, and policy
/// payloads are deliberately excluded from this immutable audit trail.
model ConversationPrivacyAudit {
  id             String       @id @default(uuid()) @db.Uuid
  archiveId      String       @db.Uuid
  conversationId String       @db.Uuid
  actorId        String
  action         String
  createdAt      DateTime     @default(now())
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@index([archiveId, conversationId, createdAt])
}

/// Account-specific immutable chat identity. Conversation is the existing
/// unified presentation aggregate and retains its V1 stable identifier.
model SourceConversation {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  unifiedConversationId           String                           @db.Uuid
  sourceNamespace                 String
  sourceConversationKey           String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  unifiedConversation             Conversation                     @relation(fields: [unifiedConversationId, archiveId], references: [id, archiveId], onDelete: Restrict)
  participants                    ConversationParticipant[]
  messages                        Message[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([id, archiveId])
  @@unique([archiveId, ownedAccountId, sourceNamespace, sourceConversationKey])
  @@unique([archiveId, id, unifiedConversationId])
  @@unique([id, unifiedConversationId, archiveId])
  @@unique([id, archiveId, ownedAccountId])
  @@index([archiveId, ownedAccountId])
  @@index([archiveId, unifiedConversationId])
  @@index([archiveId, ownedAccountId, unifiedConversationId])
}

model ConversationParticipant {
  id                   String              @id @default(uuid()) @db.Uuid
  archiveId            String              @db.Uuid
  conversationId       String              @db.Uuid
  sourceConversationId String?             @db.Uuid
  personId             String              @db.Uuid
  role                 String?
  joinedAt             DateTime?
  leftAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archive              Archive             @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation         Conversation        @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  sourceConversation   SourceConversation? @relation(fields: [sourceConversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  person               Person              @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, conversationId, personId])
  @@unique([archiveId, sourceConversationId, personId])
  @@index([archiveId, personId])
}

model Message {
  id                           String               @id @default(uuid()) @db.Uuid
  archiveId                    String               @db.Uuid
  conversationId               String               @db.Uuid
  sourceConversationId         String?              @db.Uuid
  senderId                     String?              @db.Uuid
  replyToId                    String?              @db.Uuid
  stableKey                    String
  sourceType                   String?
  sourceKey                    String?
  messageType                  String
  body                         String?
  metadata                     Json?
  materialized                 Boolean              @default(true)
  materializationRunId         String?
  materializationInputDigest   String?              @db.VarChar(64)
  materializationPolicyVersion String?
  sourceDeleted                Boolean              @default(false)
  contentUnavailable           Boolean              @default(false)
  sourceDeletedAt              DateTime?
  sourceDeletionObservationKey String?
  sourceDeletionMetadata       Json?
  ownerDeleted                 Boolean              @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  ownerDeletionVersion         Int                  @default(0)
  sentAt                       DateTime?
  firstSeenAt                  DateTime             @default(now())
  lastSeenAt                   DateTime             @default(now())
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  archive                      Archive              @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation                 Conversation         @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  sourceConversation           SourceConversation?  @relation(fields: [sourceConversationId, archiveId], references: [id, archiveId], onDelete: Restrict)
  sender                       Person?              @relation(fields: [senderId, archiveId], references: [id, archiveId], onDelete: Restrict)
  replyTo                      Message?             @relation("MessageReplies", fields: [replyToId, conversationId, archiveId], references: [id, conversationId, archiveId], onDelete: Restrict)
  replies                      Message[]            @relation("MessageReplies")
  revisions                    MessageRevision[]
  reactions                    Reaction[]
  attachments                  MessageAttachment[]
  messageObservations          MessageObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, conversationId, id])
  @@unique([archiveId, sourceConversationId, id])
  @@unique([id, archiveId, sourceConversationId])
  @@unique([archiveId, stableKey])
  @@index([archiveId, conversationId, sentAt])
  @@index([archiveId, senderId])
  @@index([archiveId, sentAt])
}

model MessageRevision {
  id                           String                @id @default(uuid()) @db.Uuid
  archiveId                    String                @db.Uuid
  messageId                    String                @db.Uuid
  revisionKey                  String
  materialized                 Boolean               @default(true)
  materializationRunId         String?
  materializationInputDigest   String?               @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean               @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  body                         String?
  metadata                     Json?
  firstSeenAt                  DateTime              @default(now())
  observedAt                   DateTime              @default(now())
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  archive                      Archive               @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message               @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  observations                 RevisionObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, revisionKey])
  @@index([archiveId, messageId, firstSeenAt])
}

model Reaction {
  id                           String                @id @default(uuid()) @db.Uuid
  archiveId                    String                @db.Uuid
  messageId                    String                @db.Uuid
  personId                     String                @db.Uuid
  emoji                        String
  stableKey                    String
  firstSeenAt                  DateTime              @default(now())
  lastSeenAt                   DateTime              @default(now())
  metadata                     Json?
  materialized                 Boolean               @default(true)
  materializationRunId         String?
  materializationInputDigest   String?               @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean               @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  archive                      Archive               @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message               @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  person                       Person                @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Restrict)
  observations                 ReactionObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, stableKey])
  @@index([archiveId, messageId])
}

model Attachment {
  id                   String              @id @default(uuid()) @db.Uuid
  archiveId            String              @db.Uuid
  stableKey            String?
  sha256               String              @db.VarChar(64)
  availability         String              @default("missing")
  casKey               String?
  originalName         String?
  originalPath         String?
  mimeType             String?
  byteSize             BigInt?
  width                Int?
  height               Int?
  durationMs           Int?
  sourceMetadata       Json?
  firstSeenAt          DateTime            @default(now())
  lastSeenAt           DateTime            @default(now())
  ownerDeleted         Boolean             @default(false)
  ownerDeletedAt       DateTime?
  ownerDeletedBy       String?
  ownerDeletionReason  String?
  ownerDeletionVersion Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archive              Archive             @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  messageLinks         MessageAttachment[]
  transcripts          Transcript[]

  @@unique([archiveId, id])
  @@unique([archiveId, stableKey])
  @@unique([archiveId, sha256])
  @@index([archiveId, availability])
}

/// Identifier-only audit receipt for reversible owner policy changes.
model OwnerDeletionAudit {
  id               String   @id @default(uuid()) @db.Uuid
  archiveId        String   @db.Uuid
  entityKind       String
  entityId         String   @db.Uuid
  action           String
  actor            String
  reason           String
  idempotencyKey   String
  policyVersion    String
  expectedVersion  Int?
  resultingVersion Int
  cascadeCount     Int      @default(0)
  occurredAt       DateTime @default(now())
  archive          Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, idempotencyKey])
  @@index([archiveId, entityKind, entityId, occurredAt])
}

model MessageAttachment {
  id                           String                           @id @default(uuid()) @db.Uuid
  archiveId                    String                           @db.Uuid
  messageId                    String                           @db.Uuid
  attachmentId                 String                           @db.Uuid
  ordinal                      Int?
  role                         String?
  metadata                     Json?
  materialized                 Boolean                          @default(true)
  materializationRunId         String?
  materializationInputDigest   String?                          @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean                          @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  archive                      Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message                          @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  attachment                   Attachment                       @relation(fields: [attachmentId, archiveId], references: [id, archiveId], onDelete: Cascade)
  observations                 AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, attachmentId])
  @@index([archiveId, messageId])
}

/// A transcription subject. The media digest is captured independently from
/// the attachment row so a changed digest makes old versions inapplicable,
/// while preserving their immutable history.
model Transcript {
  id                 String                 @id @default(uuid()) @db.Uuid
  archiveId          String                 @db.Uuid
  attachmentId       String                 @db.Uuid
  sourceMediaSha256  String                 @db.VarChar(64)
  currentMediaSha256 String                 @db.VarChar(64)
  language           String?
  selectedModel      String?
  status             String                 @default("pending")
  errorClass         String?
  manualAuthority    Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  archive            Archive                @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  attachment         Attachment             @relation(fields: [attachmentId, archiveId], references: [id, archiveId], onDelete: Restrict)
  requests           TranscriptionRequest[]
  runs               TranscriptionRun[]
  versions           TranscriptVersion[]

  @@unique([archiveId, id])
  @@unique([archiveId, attachmentId])
  @@index([archiveId, status])
}

