generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archives  Archive[]
}

model Archive {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   Source[]
  snapshots Snapshot[]
  importJobs ImportJob[]
  people    Person[]
  identities Identity[]
  conversations Conversation[]
  participants ConversationParticipant[]
  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model Source {
  id             String       @id @default(uuid()) @db.Uuid
  archiveId      String       @db.Uuid
  kind           String
  stableKey      String
  sha256         String       @db.VarChar(64)
  originalPath   String?
  provenance     Json?
  lifecycle      String       @default("discovered")
  discoveredAt   DateTime     @default(now())
  claimedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  snapshots      Snapshot[]
  importJobs     ImportJob[]
  @@unique([archiveId, kind, stableKey])
  @@unique([archiveId, id])
  @@index([archiveId, sha256])
}

model Snapshot {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  sourceId    String   @db.Uuid
  sha256      String   @db.VarChar(64)
  provenance  Json?
  lifecycle   String   @default("snapshotted")
  capturedAt DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  source      Source   @relation(fields: [sourceId, archiveId], references: [id, archiveId], onDelete: Restrict)
  archive     Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJobs  ImportJob[]
  @@unique([archiveId, id])
  @@unique([archiveId, sourceId, sha256])
  @@index([archiveId, sourceId])
}

model ImportJob {
  id          String    @id @default(uuid()) @db.Uuid
  archiveId   String    @db.Uuid
  sourceId    String    @db.Uuid
  snapshotId  String?   @db.Uuid
  status      String    @default("discovered")
  adapterVersion String?
  outcome     Json?
  errorClass  String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archive     Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  source      Source    @relation(fields: [sourceId, archiveId], references: [id, archiveId], onDelete: Restrict)
  snapshot    Snapshot? @relation(fields: [snapshotId, archiveId], references: [id, archiveId], onDelete: Restrict)
  @@unique([archiveId, id])
  @@index([archiveId, status])
}

model Person {
  id           String                   @id @default(uuid()) @db.Uuid
  archiveId    String                   @db.Uuid
  displayName  String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  archive      Archive                  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  identities   Identity[]
  participants ConversationParticipant[]
  @@unique([archiveId, id])
  @@index([archiveId])
}

model Identity {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  personId    String   @db.Uuid
  kind        String
  value       String
  displayName String?
  provenance  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archive     Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)
  @@unique([archiveId, id])
  @@unique([archiveId, kind, value])
  @@index([archiveId, personId])
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  archiveId    String                    @db.Uuid
  kind         String
  stableKey    String
  title        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  archive      Archive                   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  @@unique([archiveId, id])
  @@unique([archiveId, stableKey])
  @@index([archiveId, kind])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  archiveId      String       @db.Uuid
  conversationId String       @db.Uuid
  personId       String       @db.Uuid
  role           String?
  joinedAt       DateTime?
  leftAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archive        Archive      @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  person         Person       @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)
  @@unique([archiveId, id])
  @@unique([archiveId, conversationId, personId])
  @@index([archiveId, personId])
}
