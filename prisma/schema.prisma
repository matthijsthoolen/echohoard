/// Immutable audit trail for the current eligibility of an import. The job's
/// eligibility column is a transactional projection used by queries; these
/// rows retain every owner/automation decision.
model ImportEligibilityDecision {
  id             String    @id @default(uuid()) @db.Uuid
  archiveId      String    @db.Uuid
  importJobId    String    @db.Uuid
  eligibility    String
  actor          String
  reason         String
  idempotencyKey String
  decidedAt      DateTime
  createdAt      DateTime  @default(now())
  archive        Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJob      ImportJob @relation(fields: [importJobId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, idempotencyKey])
  @@index([archiveId, importJobId, decidedAt])
}

/// A rebuild is only current after it reaches completed. Failed/running rows
/// are retained so an interrupted apply is observable and retryable.
model MaterializationRun {
  id             String    @id @default(uuid()) @db.Uuid
  archiveId      String    @db.Uuid
  importJobId    String    @db.Uuid
  action         String
  status         String    @default("running")
  actor          String
  reason         String
  idempotencyKey String
  policyVersion  String
  inputSetDigest String    @db.VarChar(64)
  result         Json?
  errorClass     String?
  startedAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  archive        Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJob      ImportJob @relation(fields: [importJobId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, idempotencyKey])
  @@index([archiveId, importJobId, status])
}
