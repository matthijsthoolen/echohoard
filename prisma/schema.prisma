/// Typed immutable import evidence. Each table has a concrete target relation;
/// no polymorphic entity ID can dangle or cross an archive boundary.
model ConversationObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, sourceConversationId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

