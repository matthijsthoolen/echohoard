generator client {
  provider      = "prisma-client-js"
  // The packaged runtime uses Debian Bookworm/OpenSSL 3. Keep native for
  // local development while embedding the deployment engine explicitly.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archives  Archive[]
}

model Archive {
  id                              String                           @id @default(uuid()) @db.Uuid
  userId                          String                           @db.Uuid
  name                            String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  user                            User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources                         Source[]
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  importEligibilityDecisions      ImportEligibilityDecision[]
  materializationRuns             MaterializationRun[]
  ownedAccounts                   OwnedAccount[]
  people                          Person[]
  identities                      Identity[]
  conversations                   Conversation[]
  sourceConversations             SourceConversation[]
  participants                    ConversationParticipant[]
  messages                        Message[]
  revisions                       MessageRevision[]
  reactions                       Reaction[]
  attachments                     Attachment[]
  messageAttachments              MessageAttachment[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]
  admittedIdentities              ArchiveIdentity[]
  authSessions                    AuthSession[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model ArchiveIdentity {
  id         String    @id @default(uuid()) @db.Uuid
  archiveId  String    @db.Uuid
  issuer     String
  subject    String
  role       String    @default("pending")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archive    Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, issuer, subject])
  @@index([archiveId, role])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  archiveId String    @db.Uuid
  issuer    String
  subject   String
  role      String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archive   Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([expiresAt, revokedAt])
  @@index([archiveId, expiresAt])
}

model OwnedAccount {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  accountKey                      String
  displayLabel                    String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  sources                         Source[]
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  sourceConversations             SourceConversation[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, accountKey])
  @@index([archiveId])
}

model Source {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  kind                            String
  stableKey                       String
  sha256                          String                           @db.VarChar(64)
  originalPath                    String?
  provenance                      Json?
  lifecycle                       String                           @default("discovered")
  discoveredAt                    DateTime                         @default(now())
  claimedAt                       DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  snapshots                       Snapshot[]
  importJobs                      ImportJob[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@unique([archiveId, ownedAccountId, kind, stableKey])
  @@index([archiveId, sha256])
}

model Snapshot {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  sourceId                        String                           @db.Uuid
  sha256                          String                           @db.VarChar(64)
  provenance                      Json?
  lifecycle                       String                           @default("snapshotted")
  capturedAt                      DateTime                         @default(now())
  completedAt                     DateTime?
  createdAt                       DateTime                         @default(now())
  source                          Source                           @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJobs                      ImportJob[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@unique([archiveId, ownedAccountId, sourceId, sha256])
  @@index([archiveId, sourceId])
  @@index([archiveId, lifecycle, completedAt])
  @@index([archiveId, capturedAt])
}

model ImportJob {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  sourceId                        String                           @db.Uuid
  snapshotId                      String?                          @db.Uuid
  status                          String                           @default("discovered")
  eligibility                     String                           @default("eligible")
  adapterVersion                  String?
  outcome                         Json?
  errorClass                      String?
  retryable                       Boolean?
  leaseId                         String?
  leaseOwner                      String?
  leaseExpiresAt                  DateTime?
  startedAt                       DateTime?
  finishedAt                      DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                          Source                           @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot                        Snapshot?                        @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]
  importEligibilityDecisions      ImportEligibilityDecision[]
  materializationRuns             MaterializationRun[]

  @@unique([archiveId, id])
  @@unique([id, archiveId, ownedAccountId])
  @@index([archiveId, status])
  @@index([status, leaseExpiresAt])
  @@index([archiveId, createdAt])
  @@index([archiveId, eligibility])
}

model Person {
  id           String                    @id @default(uuid()) @db.Uuid
  archiveId    String                    @db.Uuid
  displayName  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  archive      Archive                   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  identities   Identity[]
  participants ConversationParticipant[]
  sentMessages Message[]
  reactions    Reaction[]

  @@unique([archiveId, id])
  @@index([archiveId])
}

model Identity {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  personId    String   @db.Uuid
  kind        String
  value       String
  displayName String?
  provenance  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archive     Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, kind, value])
  @@index([archiveId, personId])
}

model Conversation {
  id                           String                    @id @default(uuid()) @db.Uuid
  archiveId                    String                    @db.Uuid
  kind                         String
  stableKey                    String
  title                        String?
  materialized                 Boolean                   @default(true)
  materializationRunId         String?
  materializationInputDigest   String?                   @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean                   @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  archive                      Archive                   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  participants                 ConversationParticipant[]
  messages                     Message[]
  sourceConversations          SourceConversation[]

  @@unique([archiveId, id])
  @@unique([archiveId, stableKey])
  @@index([archiveId, kind])
}

/// Account-specific immutable chat identity. Conversation is the existing
/// unified presentation aggregate and retains its V1 stable identifier.
model SourceConversation {
  id                              String                           @id @default(uuid()) @db.Uuid
  archiveId                       String                           @db.Uuid
  ownedAccountId                  String                           @db.Uuid
  unifiedConversationId           String                           @db.Uuid
  sourceNamespace                 String
  sourceConversationKey           String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  archive                         Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount                    OwnedAccount                     @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  unifiedConversation             Conversation                     @relation(fields: [unifiedConversationId, archiveId], references: [id, archiveId], onDelete: Restrict)
  participants                    ConversationParticipant[]
  messages                        Message[]
  conversationObservations        ConversationObservation[]
  messageObservations             MessageObservation[]
  revisionObservations            RevisionObservation[]
  reactionObservations            ReactionObservation[]
  attachmentReferenceObservations AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, ownedAccountId, sourceNamespace, sourceConversationKey])
  @@unique([archiveId, id, unifiedConversationId])
  @@unique([id, unifiedConversationId, archiveId])
  @@unique([id, archiveId, ownedAccountId])
  @@index([archiveId, ownedAccountId])
}

model ConversationParticipant {
  id                   String              @id @default(uuid()) @db.Uuid
  archiveId            String              @db.Uuid
  conversationId       String              @db.Uuid
  sourceConversationId String?             @db.Uuid
  personId             String              @db.Uuid
  role                 String?
  joinedAt             DateTime?
  leftAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archive              Archive             @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation         Conversation        @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  sourceConversation   SourceConversation? @relation(fields: [sourceConversationId, conversationId, archiveId], references: [id, unifiedConversationId, archiveId], onDelete: Cascade)
  person               Person              @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Cascade)

  @@unique([archiveId, id])
  @@unique([archiveId, conversationId, personId])
  @@unique([archiveId, sourceConversationId, personId])
  @@index([archiveId, personId])
}

model Message {
  id                           String               @id @default(uuid()) @db.Uuid
  archiveId                    String               @db.Uuid
  conversationId               String               @db.Uuid
  sourceConversationId         String?              @db.Uuid
  senderId                     String?              @db.Uuid
  replyToId                    String?              @db.Uuid
  stableKey                    String
  sourceType                   String?
  sourceKey                    String?
  messageType                  String
  body                         String?
  metadata                     Json?
  materialized                 Boolean              @default(true)
  materializationRunId         String?
  materializationInputDigest   String?              @db.VarChar(64)
  materializationPolicyVersion String?
  sourceDeleted                Boolean              @default(false)
  contentUnavailable           Boolean              @default(false)
  sourceDeletedAt              DateTime?
  sourceDeletionObservationKey String?
  sourceDeletionMetadata       Json?
  ownerDeleted                 Boolean              @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  sentAt                       DateTime?
  firstSeenAt                  DateTime             @default(now())
  lastSeenAt                   DateTime             @default(now())
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  archive                      Archive              @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  conversation                 Conversation         @relation(fields: [conversationId, archiveId], references: [id, archiveId], onDelete: Cascade)
  sourceConversation           SourceConversation?  @relation(fields: [sourceConversationId, conversationId, archiveId], references: [id, unifiedConversationId, archiveId], onDelete: Restrict)
  sender                       Person?              @relation(fields: [senderId, archiveId], references: [id, archiveId], onDelete: Restrict)
  replyTo                      Message?             @relation("MessageReplies", fields: [replyToId, conversationId, archiveId], references: [id, conversationId, archiveId], onDelete: Restrict)
  replies                      Message[]            @relation("MessageReplies")
  revisions                    MessageRevision[]
  reactions                    Reaction[]
  attachments                  MessageAttachment[]
  messageObservations          MessageObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, conversationId, id])
  @@unique([archiveId, sourceConversationId, id])
  @@unique([id, archiveId, sourceConversationId])
  @@unique([archiveId, stableKey])
  @@index([archiveId, conversationId, sentAt])
  @@index([archiveId, senderId])
  @@index([archiveId, sentAt])
}

model MessageRevision {
  id                           String                @id @default(uuid()) @db.Uuid
  archiveId                    String                @db.Uuid
  messageId                    String                @db.Uuid
  revisionKey                  String
  materialized                 Boolean               @default(true)
  materializationRunId         String?
  materializationInputDigest   String?               @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean               @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  body                         String?
  metadata                     Json?
  firstSeenAt                  DateTime              @default(now())
  observedAt                   DateTime              @default(now())
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  archive                      Archive               @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message               @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  observations                 RevisionObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, revisionKey])
  @@index([archiveId, messageId, firstSeenAt])
}

model Reaction {
  id                           String                @id @default(uuid()) @db.Uuid
  archiveId                    String                @db.Uuid
  messageId                    String                @db.Uuid
  personId                     String                @db.Uuid
  emoji                        String
  stableKey                    String
  firstSeenAt                  DateTime              @default(now())
  lastSeenAt                   DateTime              @default(now())
  metadata                     Json?
  materialized                 Boolean               @default(true)
  materializationRunId         String?
  materializationInputDigest   String?               @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean               @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  archive                      Archive               @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message               @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  person                       Person                @relation(fields: [personId, archiveId], references: [id, archiveId], onDelete: Restrict)
  observations                 ReactionObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, stableKey])
  @@index([archiveId, messageId])
}

model Attachment {
  id                  String              @id @default(uuid()) @db.Uuid
  archiveId           String              @db.Uuid
  stableKey           String?
  sha256              String              @db.VarChar(64)
  availability        String              @default("missing")
  casKey              String?
  originalName        String?
  originalPath        String?
  mimeType            String?
  byteSize            BigInt?
  width               Int?
  height              Int?
  durationMs          Int?
  sourceMetadata      Json?
  firstSeenAt         DateTime            @default(now())
  lastSeenAt          DateTime            @default(now())
  ownerDeleted        Boolean             @default(false)
  ownerDeletedAt      DateTime?
  ownerDeletedBy      String?
  ownerDeletionReason String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  archive             Archive             @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  messageLinks        MessageAttachment[]

  @@unique([archiveId, id])
  @@unique([archiveId, stableKey])
  @@unique([archiveId, sha256])
  @@index([archiveId, availability])
}

model MessageAttachment {
  id                           String                           @id @default(uuid()) @db.Uuid
  archiveId                    String                           @db.Uuid
  messageId                    String                           @db.Uuid
  attachmentId                 String                           @db.Uuid
  ordinal                      Int?
  role                         String?
  metadata                     Json?
  materialized                 Boolean                          @default(true)
  materializationRunId         String?
  materializationInputDigest   String?                          @db.VarChar(64)
  materializationPolicyVersion String?
  ownerDeleted                 Boolean                          @default(false)
  ownerDeletedAt               DateTime?
  ownerDeletedBy               String?
  ownerDeletionReason          String?
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  archive                      Archive                          @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  message                      Message                          @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Cascade)
  attachment                   Attachment                       @relation(fields: [attachmentId, archiveId], references: [id, archiveId], onDelete: Cascade)
  observations                 AttachmentReferenceObservation[]

  @@unique([archiveId, id])
  @@unique([archiveId, messageId, attachmentId])
  @@index([archiveId, messageId])
}

/// Typed immutable import evidence. Each table has a concrete target relation;
/// no polymorphic entity ID can dangle or cross an archive boundary.
model ConversationObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, sourceConversationId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

model MessageObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  messageId             String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  message               Message            @relation(fields: [messageId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, messageId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

model RevisionObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  revisionId            String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  revision              MessageRevision    @relation(fields: [revisionId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, revisionId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

model ReactionObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  reactionId            String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  reaction              Reaction           @relation(fields: [reactionId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, reactionId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

model AttachmentReferenceObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  archiveId             String             @db.Uuid
  ownedAccountId        String             @db.Uuid
  sourceId              String             @db.Uuid
  snapshotId            String?            @db.Uuid
  importJobId           String             @db.Uuid
  sourceConversationId  String             @db.Uuid
  messageAttachmentId   String             @db.Uuid
  sourceNamespace       String
  sourceConversationKey String
  sourceEntityKey       String
  logicalEntityKey      String
  observationKey        String
  observationKind       String
  eligibility           String             @default("eligible")
  valueDigest           String             @db.VarChar(64)
  observedValue         Json?
  observedAt            DateTime
  createdAt             DateTime           @default(now())
  archive               Archive            @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  ownedAccount          OwnedAccount       @relation(fields: [ownedAccountId, archiveId], references: [id, archiveId], onDelete: Restrict)
  source                Source             @relation(fields: [sourceId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  snapshot              Snapshot?          @relation(fields: [snapshotId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  importJob             ImportJob          @relation(fields: [importJobId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  sourceConversation    SourceConversation @relation(fields: [sourceConversationId, archiveId, ownedAccountId], references: [id, archiveId, ownedAccountId], onDelete: Restrict)
  messageAttachment     MessageAttachment  @relation(fields: [messageAttachmentId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, observationKind, sourceConversationId, sourceEntityKey, observationKey])
  @@index([archiveId, messageAttachmentId, observedAt])
  @@index([archiveId, logicalEntityKey])
}

/// Immutable audit trail for the current eligibility of an import. The job's
/// eligibility column is a transactional projection used by queries; these
/// rows retain every owner/automation decision.
model ImportEligibilityDecision {
  id             String    @id @default(uuid()) @db.Uuid
  archiveId      String    @db.Uuid
  importJobId    String    @db.Uuid
  eligibility    String
  actor          String
  reason         String
  idempotencyKey String
  decidedAt      DateTime
  createdAt      DateTime  @default(now())
  archive        Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJob      ImportJob @relation(fields: [importJobId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, idempotencyKey])
  @@index([archiveId, importJobId, decidedAt])
}

/// A rebuild is only current after it reaches completed. Failed/running rows
/// are retained so an interrupted apply is observable and retryable.
model MaterializationRun {
  id             String    @id @default(uuid()) @db.Uuid
  archiveId      String    @db.Uuid
  importJobId    String    @db.Uuid
  action         String
  status         String    @default("running")
  actor          String
  reason         String
  idempotencyKey String
  policyVersion  String
  inputSetDigest String    @db.VarChar(64)
  result         Json?
  errorClass     String?
  startedAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  archive        Archive   @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  importJob      ImportJob @relation(fields: [importJobId, archiveId], references: [id, archiveId], onDelete: Restrict)

  @@unique([archiveId, id])
  @@unique([archiveId, importJobId, idempotencyKey])
  @@index([archiveId, importJobId, status])
}
